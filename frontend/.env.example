# Backend origin (e.g. https://api.brainjot.space). Empty = same-origin /api.
VITE_API_URL=

# Product analytics (PostHog). Leave empty to disable all tracking —
# every analytics call is a no-op without a key. Get the key from
# PostHog project settings ("Project API key", starts with phc_).
VITE_POSTHOG_KEY=
# Only set if your PostHog project is on the EU cloud (https://eu.i.posthog.com).
VITE_POSTHOG_HOST=
